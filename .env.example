# Perplexity Sonar API key (https://docs.perplexity.ai/)
# Required to run scripts/refresh-brief.ts. The web app itself does NOT read this.
PERPLEXITY_API_KEY=

# Optional: override the Sonar model used for synthesis (default: sonar-reasoning-pro).
# Discovery defaults to sonar-pro. See lib/perplexity.ts for available models.
# PERPLEXITY_MODEL_SYNTHESIS=sonar-reasoning-pro
# PERPLEXITY_MODEL_DISCOVERY=sonar-pro

# Optional: override the date used by refresh-brief (YYYY-MM-DD). Defaults to today UTC.
# REFRESH_DATE=2025-01-15
